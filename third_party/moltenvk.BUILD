# MoltenVK's prebuilt library, as data: the Vulkan backend loads it from the
# program's runfiles on a Mac
exports_files(
    [
        "LICENSE",
        "MoltenVK/dynamic/dylib/macOS/libMoltenVK.dylib",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "moltenvk",
    srcs = [
        "LICENSE",
        "MoltenVK/dynamic/dylib/macOS/libMoltenVK.dylib",
    ],
    visibility = ["//visibility:public"],
)
