# Waffles keeps its own style (tabs, its own names), so not the repo's naming
# rules; the rest of the repo's checks apply.
#
# Not yet the static analyzer (clang-analyzer-*): its first run found about
# 100 paths in Waffles' older code (null pointers, uninitialised values,
# array bounds), many likely false alarms, to be gone through on their own
# (the top-level README's roadmap)
InheritParentConfig: true
Checks: '-readability-identifier-naming,-clang-analyzer-*'
