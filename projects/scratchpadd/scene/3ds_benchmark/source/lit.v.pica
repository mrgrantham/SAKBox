; The lit case, for the PICA200's fragment lighting: each vertex placed by
; modelView and projection, its normal turned by modelView and passed on as
; a quaternion (as devkitPro's lenny example does), the view vector, and
; its colour (bytes, 0-255), which the texture combiner multiplies by the
; lighting

.fvec projection[4], modelView[4]

.constf consts(0.0, 1.0, -1.0, 0.5)
.constf bytes(0.00392156862745, 0.0, 0.0, 0.0) ; (1/255)
.alias  zeros consts.xxxx
.alias  ones  consts.yyyy
.alias  half  consts.wwww

.out outpos position
.out outclr color
.out outview view
.out outnq normalquat

.in inpos v0
.in innrm v1
.in inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	mov outview, -r1

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	; The normal, turned by modelView and normalised
	dp3 r14.x, modelView[0], innrm
	dp3 r14.y, modelView[1], innrm
	dp3 r14.z, modelView[2], innrm
	dp3 r6.x, r14, r14
	rsq r6.x, r6.x
	mul r14.xyz, r14.xyz, r6.x

	; As the quaternion turning +z to it
	mov r0, consts.yxxx
	add r4, ones, r14.z
	mul r4, half, r4
	cmp zeros, ge, ge, r4.x
	rsq r4, r4.x
	mul r5, half, r14
	jmpc cmp.x, degenerate

	rcp r0.z, r4.x
	mul r0.xy, r5, r4

degenerate:
	mov outnq, r0
	mul outclr, bytes.xxxx, inclr
	end
.end
