; The unlit case: each vertex placed by modelView and projection, with its
; colour (bytes, 0-255) as it is

.fvec projection[4], modelView[4]

.constf consts(0.0, 1.0, 0.00392156862745, 0.5) ; (1/255)
.alias  ones       consts.yyyy
.alias  fromBytes  consts.zzzz

.out outpos position
.out outclr color

.in inpos v0
.in innrm v1 ; (unused here: the vertex format is the lit case's)
.in inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul outclr, fromBytes, inclr
	end
.end
