; Lines on the 3DS, which draws only triangles: each pair of vertices from
; scene.v.pica (a line's ends, in clip space, with their colours) becomes a
; quad a pixel wide on the screen, as two triangles: each end moved half a
; pixel either way across the line. A line with an end behind the eye
; isn't drawn.

.gsh point c0

.constf consts(0.0, 1.0, 0.000001, 0.0)
; Pixels per unit of the screen's x and y over w (the top screen's render
; target is 240 x 400, the projection turned to fit it), and half a pixel
; in those units
.constf pixels(120.0, 200.0, 0.0, 0.0)
.constf halfPixel(0.0041666667, 0.0025, 0.0, 0.0)
.alias  zeros consts.xxxx
.alias  tiny  consts.zzzz

.out outpos position
.out outclr color

; v0, v1: the first end's position and colour; v2, v3: the second's
.entry gmain
.proc gmain
	; Behind the eye (w at or below 0): not drawn
	mov r0.x, v0.w
	mov r0.y, v2.w
	cmp zeros, ge, ge, r0
	jmpc cmp.x, done
	jmpc cmp.y, done

	; Each end on the screen (x and y over w)
	rcp r1.x, v0.w
	mul r1.xy, v0.xy, r1.xx
	rcp r2.x, v2.w
	mul r2.xy, v2.xy, r2.xx

	; Across the line, in pixels, at length 1 (a point's line, any way)
	add r3.xy, r2.xy, -r1.xy
	mul r3.xy, pixels.xy, r3.xy
	mov r4.x, -r3.y
	mov r4.y, r3.x
	mov r4.zw, zeros
	dp3 r5.x, r4, r4
	add r5.x, tiny, r5.x
	rsq r5.x, r5.x
	mul r4.xy, r4.xy, r5.xx

	; Half a pixel that way, at each end (times its w, back in clip space)
	mul r4.xy, halfPixel.xy, r4.xy
	mov r6, zeros
	mov r7, zeros
	mul r6.xy, r4.xy, v0.ww
	mul r7.xy, r4.xy, v2.ww

	; The first end either side (r8, r9), the second (r10, r11)
	add r8, v0, r6
	add r9, v0, -r6
	add r10, v2, r7
	add r11, v2, -r7

	; Two triangles: first+, first-, second+; first-, second-, second+
	setemit 0
	mov outpos, r8
	mov outclr, v1
	emit
	setemit 1
	mov outpos, r9
	mov outclr, v1
	emit
	setemit 2, prim
	mov outpos, r10
	mov outclr, v3
	emit

	setemit 0
	mov outpos, r9
	mov outclr, v1
	emit
	setemit 1
	mov outpos, r11
	mov outclr, v3
	emit
	setemit 2, prim
	mov outpos, r10
	mov outclr, v3
	emit

done:
	end
.end
