; The overlay on the 3DS: its triangles' corners in screen points (x
; right, y down from the top-left) placed by an orthographic projection,
; with their colours (bytes, 0-255)

.fvec projection[4]

.constf consts(0.0, 1.0, 0.00392156862745, -0.5) ; (1/255; z halfway in)
.alias  fromBytes consts.zzzz

.out outpos position
.out outclr color

.in inpos v0
.in inclr v1

.proc main
	mov r0, consts.xxwy
	mov r0.xy, inpos.xy
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mul outclr, fromBytes, inclr
	end
.end
