; The overlay on the 3DS: its triangles' corners in screen points (x
; right, y down from the top-left) placed by an orthographic projection,
; with their colours (bytes, 0-255) and where they are in the font's atlas
; (the letters, or its solid corner for shapes), as given: the atlas is
; loaded last row first, so the GPU's t (from the bottom) is its v (from
; the top), as every texture's is (TextureTiles.hpp)

.fvec projection[4]

.constf consts(0.0, 1.0, 0.00392156862745, -0.5) ; (1/255; z halfway in)
.alias  fromBytes consts.zzzz

.out outpos position
.out outclr color
.out outtc0 texcoord0

.in inpos v0
.in inclr v1
.in inatlas v2

.proc main
	mov r0, consts.xxwy
	mov r0.xy, inpos.xy
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mul outclr, fromBytes, inclr
	mov outtc0, inatlas
	end
.end
