module(name = "sakbox")

# Rule sets
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_python", version = "2.4.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_apple", version = "5.3.0", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "apple_support", version = "2.10.1", repo_name = "build_bazel_apple_support")

# The C++ toolchains Bazel finds on the machine, named in .bazelrc to pick
# clang-cl on Windows
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# Libraries from the Bazel Central Registry
# fmt, spdlog and fmtlog are kept on the same fmt major version (11).
# fmt 10 does not compile with Apple clang 21 in C++20 mode.
bazel_dep(name = "fmt", version = "11.2.0.bcr.1")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", repo_name = "gtest")
bazel_dep(name = "catch2", version = "3.15.1")
bazel_dep(name = "libstemmer", version = "2.2.0")
bazel_dep(name = "libjpeg_turbo", version = "3.1.3.bcr.6")

# Mesh simplification for the cook tool (//tools/assets), MIT
bazel_dep(name = "meshoptimizer", version = "1.3.bcr.1")
# Apple's C++ wrapper for Metal, Foundation and QuartzCore, for the scene
# layer's Metal backend (//projects/scratchpadd/scene/metal), Apache-2.0
bazel_dep(name = "metal-cpp", version = "26")
# Windows and OpenGL for the desktop (GLFW, zlib licence) and OpenGL's
# functions (GLEW, BSD/MIT), built by Bazel on every desktop, Windows too
# (built with CMake before, which hung on Windows on ARM). On Linux GLFW
# builds its X11 and Wayland libraries from source as well.
bazel_dep(name = "glfw", version = "3.4.0.bcr.4")
bazel_dep(name = "glew", version = "2.3.1.bcr.1")
# The rest of the libraries the examples use, also built by Bazel on every
# platform (they were CMake and configure builds through rules_foreign_cc,
# which hangs on Windows on ARM)
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")
bazel_dep(name = "libpng", version = "1.6.58.bcr.1")
bazel_dep(name = "sdl2", version = "2.32.0.bcr.beta.7")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")
bazel_dep(name = "rapidyaml", version = "0.12.1")
bazel_dep(name = "opencv", version = "5.0.0.bcr.9")

# OpenCV's SIMD code for newer ARM features gets its -march flags for GCC and
# Clang only, not clang-cl, so it didn't compile on Windows on ARM
single_version_override(
    module_name = "opencv",
    patch_strip = 1,
    patches = ["//third_party:opencv_clang_cl_arm64.patch"],
)

# Libraries built with our own BUILD files in //third_party
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

new_git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

# Audio output and decoding (WAV, FLAC, MP3) for ScratchPadd's audio
# (//projects/scratchpadd/audio). Public domain or MIT-0.
http_archive(
