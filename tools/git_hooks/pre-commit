#!/usr/bin/env python3
"""Git pre-commit hook: runs clang-tidy on the C++ files being committed.

Turn it on once per clone:   git config core.hooksPath tools/git_hooks
Skip it for one commit:      git commit --no-verify

It checks the staged C++ files under the projects tools/clang_tidy/run.py
covers (not upstream code it excludes), with the repo's
.clang-tidy, and blocks the commit only if clang-tidy finds something in
those files. A staged header is checked through its project's source files
(clang-tidy sees headers only as part of the files that include them).

It checks the files as they are in the working tree, so stage everything
you mean to commit. If clang-tidy isn't installed or there's no
compile_commands.json, it says so and lets the commit through.
"""

import importlib.util
import pathlib
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parents[2]
SOURCES = (".c", ".cc", ".cpp", ".cxx")
HEADERS = (".h", ".hh", ".hpp", ".hxx")

# The clang-tidy runner, for its settings and functions (without leaving a
# __pycache__ folder in the repo)
sys.dont_write_bytecode = True
spec = importlib.util.spec_from_file_location("clang_tidy_run", REPO / "tools/clang_tidy/run.py")
run = importlib.util.module_from_spec(spec)
spec.loader.exec_module(run)


def note(message):
    print(f"pre-commit (clang-tidy): {message}", file=sys.stderr)


def project_of(path):
    """The folder whose sources stand in for a header: the example's own
    folder under projects/examples, otherwise the project's."""
    parts = pathlib.PurePosixPath(path).parts
    return "/".join(parts[:3] if parts[1] == "examples" else parts[:2])


def main():
    staged = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"],
                            cwd=REPO, capture_output=True, text=True, check=True).stdout.split()
    files = [f for f in staged
             if f.endswith(SOURCES + HEADERS)
             and any(f.startswith(p + "/") for p in run.DEFAULT_PATHS)
             and f not in run.EXCLUDE]
    if not files:
        return 0

    if not run.find_tool("clang-tidy", "CLANG_TIDY", required=False):
        note("clang-tidy isn't installed (macOS: brew install llvm), so not checking.")
        return 0
    if not (REPO / "compile_commands.json").exists():
        note("no compile_commands.json (python3 tools/compile_commands/refresh.py), so not checking.")
        return 0

    compiled = set(subprocess.run(
        [sys.executable, "-c", "import json,sys; print('\\n'.join(e['file'] for e in json.load(open(sys.argv[1]))))",
         str(REPO / "compile_commands.json")], capture_output=True, text=True).stdout.split())
    targets = set()
    for f in files:
        if f.endswith(HEADERS):
            targets.add(project_of(f))
        elif f in compiled or str(REPO / f) in compiled:
            targets.add(f)
        else:
            note(f"{f} isn't in compile_commands.json (new file? run "
                 "python3 tools/compile_commands/refresh.py), so not checking it.")
    if not targets:
        return 0

    findings, result = run.tidy(run.source_regex(sorted(targets)))
    mine = [f for f in findings if f[0] in files]
    if not mine and result.returncode != 0 and not findings:
        note("clang-tidy didn't run properly, so not blocking:\n" + result.stderr[-1500:])
        return 0
    if mine:
        run.print_findings(mine)
        note(f"found problems in the files being committed. Fix them (or apply "
             f"clang-tidy's fixes with tools/clang_tidy/run.py --fix FILE), or skip "
             f"this check with git commit --no-verify.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
