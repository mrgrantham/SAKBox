# Builds the repo with GCC 14, as a Linux user with GCC would (see README.md).
FROM gcc:14

# The packages the README's Linux notes list, for the windowing and OpenGL
# examples and MIDI input (ALSA), and Python for the repo's tools
RUN apt-get update -qq \
 && apt-get install -y -qq libxinerama-dev libxrandr-dev libxcursor-dev libxi-dev \
      libglu1-mesa-dev libgl1-mesa-dev libegl1-mesa-dev libasound2-dev python3 >/dev/null \
 && rm -rf /var/lib/apt/lists/*

# Bazelisk, which runs the Bazel version pinned in .bazelversion
RUN curl -fsSL -o /usr/local/bin/bazel \
      https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-linux-$(dpkg --print-architecture) \
 && chmod +x /usr/local/bin/bazel
