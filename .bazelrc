# Flags spelt the same by GCC and Clang (Linux, macOS) and clang-cl
# (Windows) are set for every platform. The few clang-cl spells its own way
# are in gcc_and_clang and clang_cl, and each platform takes one of them.
common --enable_platform_specific_config
build:linux --config=gcc_and_clang
build:macos --config=gcc_and_clang
build:windows --config=clang_cl

build:gcc_and_clang --cxxopt=-std=c++26
# Floating-point results the same on every platform: no fused multiply-adds
# (Clang fuses a * b + c by default, GCC in strict ISO mode doesn't, and the
# fused result is rounded once instead of twice), in every library and in
# tools that run during the build. See the README's "Floating-point results
# across platforms".
build:gcc_and_clang --copt=-ffp-contract=off
build:gcc_and_clang --host_copt=-ffp-contract=off
# Strict ISO C++ for the repo's own code: compiler extensions are errors.
# External libraries are left alone.
build:gcc_and_clang --per_file_copt='^projects/.*@-pedantic-errors'

# Windows: Clang's MSVC-compatible driver (clang-cl), with MSVC's libraries
# (see the README's Windows notes). It takes GCC-style flags it doesn't
# have a spelling for after /clang:.
build:clang_cl --extra_execution_platforms=//tools/windows:clang_cl
build:clang_cl --extra_toolchains=@local_config_cc//:cc-toolchain-arm64_windows-clang-cl
build:clang_cl --extra_toolchains=@local_config_cc//:cc-toolchain-x64_windows-clang-cl
# (in place of the toolchain's /std:c++17, which would be reported unused)
build:clang_cl --features=-default_cpp_std
build:clang_cl --cxxopt=/clang:-std=c++26
build:clang_cl --copt=/clang:-ffp-contract=off
build:clang_cl --host_copt=/clang:-ffp-contract=off
# (clang-cl hasn't -pedantic-errors, even after /clang:; with -Wpedantic,
# set for every platform, -Werror=pedantic does the same)
build:clang_cl --per_file_copt='^projects/.*@-Werror=pedantic'
# M_PI and the other maths constants, which <cmath> has on Linux and macOS
# but MSVC's only with this
build:clang_cl --copt=/D_USE_MATH_DEFINES
build:clang_cl --host_copt=/D_USE_MATH_DEFINES
# Runfiles trees (the files a test or tool reads, by path), which Bazel
# leaves out on Windows unless asked; they're symbolic links, so Windows
# needs Developer Mode on (see the README)
build:clang_cl --enable_runfiles
build:clang_cl --config=clang

# The repo's own code is warning-free; keep it that way.
build --per_file_copt='^projects/.*@-Werror'
# Overriding functions must say `override` (see the README's Code
# conventions).
build --per_file_copt='^projects/.*@-Wsuggest-override'
# A class with virtual functions must have a virtual destructor (or a
# protected one), so deleting or destroying it through a base can't skip the
# derived part. Clang only reported it on Linux, where GCC's standard library
# destroys std::variant members a way that shows it.
build --per_file_copt='^projects/.*@-Wnon-virtual-dtor'
# External libraries' headers are included as system headers (-isystem), so
# these checks apply to the repo's code and not to what it includes from them.
build --features=external_include_paths
build --cxxopt='-Wpedantic'
build --cxxopt='-Werror=return-type'

# Checks only Clang has; GCC rejects them as unknown options. macOS and
# Windows always build with Clang, so they turn them on themselves; on
# Linux, add --config=clang when building with Clang (see the README's
# Getting Started).
build:macos --config=clang
# Destructors too must say `override`.
build:clang --per_file_copt='^projects/.*@-Wsuggest-destructor-override'
# Doc comments must match the code they describe: a @param naming a
# parameter that doesn't exist, a @return on a void function, and so on
# (see the README's Code conventions). It doesn't require comments.
build:clang --per_file_copt='^projects/.*@-Wdocumentation'
# build --cxxopt='-Werror'

# this is to address the following error
# https://github.com/bazelbuild/bazel/issues/16413
# can be removed when bazel addresses
# build --linkopt=-Wl
# build --linkopt=-no_fixup_chains

build --color=yes
