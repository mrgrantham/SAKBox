build --cxxopt='-std=c++26'
# Strict ISO C++ for the repo's own code: compiler extensions are errors.
# External libraries are left alone.
build --per_file_copt='^projects/.*@-pedantic-errors'
# The repo's own code is warning-free; keep it that way.
build --per_file_copt='^projects/.*@-Werror'
# Overriding functions, destructors included, must say `override` (see the
# README's Code conventions).
build --per_file_copt='^projects/.*@-Wsuggest-override,-Wsuggest-destructor-override'
# Doc comments must match the code they describe: a @param naming a
# parameter that doesn't exist, a @return on a void function, and so on
# (see the README's Code conventions). It doesn't require comments.
build --per_file_copt='^projects/.*@-Wdocumentation'
# External libraries' headers are included as system headers (-isystem), so
# these checks apply to the repo's code and not to what it includes from them.
build --features=external_include_paths
build --cxxopt='-Wpedantic'
build:clang --cxxopt='-Werror=inconsistent-missing-override'
build:clang --cxxopt='-Werror=delete-abstract-non-virtual-dtor'
build --cxxopt='-Werror=return-type'
# build --cxxopt='-Werror'

# this is to address the following error
# https://github.com/bazelbuild/bazel/issues/16413
# can be removed when bazel addresses
# build --linkopt=-Wl
# build --linkopt=-no_fixup_chains

build --color=yes
